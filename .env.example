# API Keys
GROQ_API_KEY=your_groq_api_key_here
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database & State
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_quant_db

# Scheduled scanner (worker service)
# Leave AEGIS_WATCHLIST blank to rotate through the curated 50-symbol universe
# in backend/core/universe.py; set it to a comma-separated list to override.
AEGIS_WATCHLIST=
AEGIS_SCAN_BATCH_SIZE=10
AEGIS_SCAN_INTERVAL_MINUTES=60
AEGIS_SCAN_DRY_RUN=false
AEGIS_SCAN_SKIP_HELD=true
AEGIS_SCAN_MARKET_HOURS_ONLY=true
AEGIS_SCAN_ENABLED=true
AEGIS_SCAN_TICKER_DELAY_SECONDS=2
# Test-only overrides (pass with docker compose run -e ...):
# AEGIS_SCAN_RUN_ONCE=true
# AEGIS_SCAN_FORCE=true